# Copia este archivo como .env y llena tus datos.

# ---- Opción 1: PostgreSQL local o en Docker (la misma conexión que usan en DBeaver)
PGHOST=localhost
PGPORT=5432
PGDATABASE=vuela_db
PGUSER=postgres
PGPASSWORD=

# ---- Opción 2: Supabase (botón Connect → Session pooler). Comenta la opción 1 y usa:
# PGHOST=aws-X-REGION.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.REFERENCIA_DEL_PROYECTO
# PGPASSWORD=la contraseña de la base del proyecto
# PGSSLMODE=no-verify
# (no-verify: la conexión va cifrada; no se valida el certificado de Supabase,
#  que no lo emite una autoridad pública. No uses el «Transaction pooler».)

# Puerto donde se abre la app: http://localhost:3000
PORT=3000

# Radio en km para asignar el sitio más cercano a un avistamiento.
# Si no hay ningún sitio dentro del radio, o la app no tuvo GPS, se asigna «Otro».
RADIO_SITIO_KM=2

# Días que dura una sesión abierta en la app (después hay que volver a iniciar sesión).
DIAS_SESION=30

# Conexiones simultáneas a la base. El «Session pooler» gratis de Supabase admite pocas
# y las comparten todas las copias del servidor (cada compañero y la versión publicada).
PG_POOL_MAX=5
